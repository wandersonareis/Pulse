<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Pulse</RootNamespace>
    <AssemblyName>Pulse</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationIcon>ff.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App.xaml.cs" />
    <Compile Include="UiGamePartSelectDialog.xaml.cs" />
    <Compile Include="Properties\Resources.Designer.cs" />
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="UiGamePartSelectDialog.xaml" />
    <EmbeddedResource Include="Properties\Resources.resx" />
    <Resource Include="ff.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pulse.Core\Pulse.Core.csproj" />
    <ProjectReference Include="..\Pulse.FS\Pulse.FS.csproj" />
    <ProjectReference Include="..\Pulse.DriectX\Pulse.DirectX.csproj" />
    <ProjectReference Include="..\Pulse.UI\Pulse.UI.csproj" />
  </ItemGroup>
</Project>
